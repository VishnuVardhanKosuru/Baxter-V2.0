# ── Environment & Secrets ─────────────────────────────────────────────────────
# Never commit real credentials. .env.example is the tracked template.
.env
.env.*
*.env
!.env.example

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Node / frontend build ─────────────────────────────────────────────────────
node_modules
dist
dist-ssr
*.local
.vite/

# ── Python virtual environments ───────────────────────────────────────────────
venv/
env/
ENV/
.venv/

# ── Python cache, bytecode & build artefacts ──────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Test & tooling caches ─────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# ── Editor & OS files ─────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# ── Runtime data directories ──────────────────────────────────────────────────
# Generated artefacts and ingested documents — regenerated by the pipeline and
# potentially containing customer requirement documents, so never committed.
uploads/
output/
input_modules/
**/output/
**/input_modules/
