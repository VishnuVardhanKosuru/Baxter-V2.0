GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection:
# High-quota models (500 RPD, 15 RPM):
GEMINI_MODEL=gemini-3.5-flash-lite
# Alternative high-quota option:
# GEMINI_MODEL=gemini-3.1-flash-lite
