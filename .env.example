# ==============================================================================
# Baxter V2.0 — Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#   cp .env.example .env
# Every value below is optional except at least ONE LLM provider key.
# ==============================================================================

# -- LLM PROVIDER KEYS ---------------------------------------------------------
# At least one key is REQUIRED. Add _2 ... _9 suffixes to enable multi-key
# load balancing (LiteLLM routes to the least-busy key).
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Alternative providers (auto-detected from LLM_MODEL prefix)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -- MODEL SELECTION -----------------------------------------------------------
# Provider is auto-detected from the model prefix:
#   gemini-*             -> Google Gemini
#   gpt-* / o1-* / o3-*  -> OpenAI
#   claude-*             -> Anthropic
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2

# -- RATE LIMITS (per key) -----------------------------------------------------
# Effective batch concurrency = min(RPM x active_keys, LLM_MAX_CONCURRENCY)
GEMINI_RPM=50
GEMINI_TPM=4000000
OPENAI_RPM=500
OPENAI_TPM=2000000
ANTHROPIC_RPM=50
ANTHROPIC_TPM=2000000

# Hard ceiling on simultaneous in-flight LLM calls (memory guard)
LLM_MAX_CONCURRENCY=500
# Override auto-computed concurrency entirely (leave blank to auto-compute)
WORKER_CONCURRENCY=

# -- LLM RESILIENCE ------------------------------------------------------------
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=5
LLM_ROUTER_RETRIES=5
RATE_LIMIT_BASE_WAIT_S=30
NETWORK_BASE_WAIT_S=3
# Gemini explicit context-cache lifetime, in minutes
LLM_CACHE_TTL_MINUTES=60

# -- SERVER --------------------------------------------------------------------
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# Auto-reload on code change. NEVER enable in production.
SERVER_RELOAD=false
# Comma-separated allowed CORS origins.
# "*" is DEV ONLY and disables credentialed CORS. In production set explicitly:
#   ALLOWED_ORIGINS=https://baxter.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Max accepted upload size per file, in megabytes
MAX_UPLOAD_MB=25
# Return internal exception text in HTTP error responses. DEV ONLY.
DEBUG_ERRORS=false

# -- LOGGING -------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Write logs to logs/baxter.log in addition to stdout
LOG_TO_FILE=false

# -- APPLICATION DEFAULTS ------------------------------------------------------
# Base URL injected into generated Selenium scripts
BASE_URL=https://shop.shopsphere.com
DEFAULT_PROJECT_NAME=ShopSphere
DEFAULT_VERSION=2.0

# Sample document filenames, resolved inside samples/
SAMPLE_FRD=ShopSphere_Functional_Requirements_Document.docx
SAMPLE_TC=ShopSphere_Manual_Testcases.docx

# -- JIRA INTEGRATION (optional) -----------------------------------------------
# Can also be supplied per-request from the UI via X-Jira-* headers.
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_TIMEOUT_S=30
JIRA_MAX_RESULTS=100
# Model used by the Jira attachment classifier
JIRA_GEMINI_MODEL=gemini-flash-latest
JIRA_OPENAI_MODEL=gpt-4o-mini
